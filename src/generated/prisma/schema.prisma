// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PageStatus {
  draft
  published
}

enum ContentStatus {
  draft
  published
  inactive
}

enum ArticleStatus {
  draft
  published
  archived
}

enum CtaType {
  whatsapp
  url
  contact
}

model Admin {
  id           BigInt        @id @default(autoincrement())
  email        String        @unique @db.VarChar(191)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(191)
  isActive     Boolean       @default(true) @map("is_active")
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  mediaUploads MediaUpload[]

  @@map("admins")
}

model Page {
  id          BigInt     @id @default(autoincrement())
  pageKey     String     @unique @map("page_key") @db.VarChar(100)
  title       String     @db.VarChar(255)
  contentJson Json       @map("content_json")
  status      PageStatus @default(draft)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([pageKey])
  @@map("pages")
}

model Service {
  id         BigInt        @id @default(autoincrement())
  title      String        @db.VarChar(255)
  slug       String        @unique @db.VarChar(255)
  summary    String        @db.Text
  content    String        @db.Text
  coverImage String?       @map("cover_image") @db.VarChar(255)
  featured   Boolean       @default(false)
  sortOrder  Int           @default(0) @map("sort_order")
  status     ContentStatus @default(draft)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  faqs       ServiceFaq[]
  ctas       ServiceCta[]

  @@index([slug])
  @@map("services")
}

model ServiceFaq {
  id        BigInt   @id @default(autoincrement())
  serviceId BigInt   @map("service_id")
  question  String   @db.VarChar(255)
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_faqs")
}

model ServiceCta {
  id        BigInt   @id @default(autoincrement())
  serviceId BigInt   @map("service_id")
  label     String   @db.VarChar(191)
  link      String   @db.VarChar(255)
  type      CtaType
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_ctas")
}

model Lawyer {
  id        BigInt        @id @default(autoincrement())
  name      String        @db.VarChar(191)
  slug      String        @unique @db.VarChar(191)
  photo     String?       @db.VarChar(255)
  position  String        @db.VarChar(191)
  shortBio  String        @map("short_bio") @db.Text
  fullBio   String        @map("full_bio") @db.Text
  specialty String        @db.VarChar(255)
  featured  Boolean       @default(false)
  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(draft)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@map("lawyers")
}

model ArticleCategory {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(191)
  slug      String    @unique @db.VarChar(191)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  articles  Article[]

  @@index([slug])
  @@map("article_categories")
}

model Article {
  id          BigInt           @id @default(autoincrement())
  categoryId  BigInt?          @map("category_id")
  title       String           @db.VarChar(255)
  slug        String           @unique @db.VarChar(255)
  excerpt     String?          @db.Text
  thumbnail   String?          @db.VarChar(255)
  content     String           @db.Text
  featured    Boolean          @default(false)
  publishedAt DateTime?        @map("published_at")
  status      ArticleStatus    @default(draft)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  category    ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([categoryId])
  @@map("articles")
}

model Client {
  id               BigInt        @id @default(autoincrement())
  name             String        @db.VarChar(191)
  slug             String?       @unique @db.VarChar(191)
  logo             String?       @db.VarChar(255)
  shortDescription String?       @map("short_description") @db.Text
  category         String?       @db.VarChar(191)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0) @map("sort_order")
  status           ContentStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@map("clients")
}

model SiteSetting {
  id              BigInt   @id @default(autoincrement())
  siteName        String?  @map("site_name") @db.VarChar(191)
  siteTagline     String?  @map("site_tagline") @db.VarChar(255)
  logoLight       String?  @map("logo_light") @db.VarChar(255)
  logoDark        String?  @map("logo_dark") @db.VarChar(255)
  primaryColor    String?  @map("primary_color") @db.VarChar(50)
  secondaryColor  String?  @map("secondary_color") @db.VarChar(50)
  whatsappNumber  String?  @map("whatsapp_number") @db.VarChar(50)
  whatsappMessage String?  @map("whatsapp_message") @db.VarChar(255)
  email           String?  @db.VarChar(191)
  phone           String?  @db.VarChar(50)
  officeAddress   String?  @map("office_address") @db.Text
  mapEmbedUrl     String?  @map("map_embed_url") @db.Text
  footerText      String?  @map("footer_text") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model SeoMeta {
  id              BigInt   @id @default(autoincrement())
  entityType      String   @map("entity_type") @db.VarChar(50)
  entityId        BigInt   @map("entity_id")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  ogImage         String?  @map("og_image") @db.VarChar(255)
  canonicalUrl    String?  @map("canonical_url") @db.VarChar(255)
  robots          String?  @db.VarChar(100)
  schemaType      String?  @map("schema_type") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
  @@map("seo_meta")
}

model MediaUpload {
  id                BigInt   @id @default(autoincrement())
  module            String   @db.VarChar(100)
  originalName      String   @map("original_name") @db.VarChar(255)
  fileName          String   @map("file_name") @db.VarChar(255)
  filePath          String   @map("file_path") @db.VarChar(500)
  fileUrl           String   @map("file_url") @db.VarChar(500)
  mimeType          String   @map("mime_type") @db.VarChar(100)
  fileSize          BigInt   @map("file_size")
  uploadedByAdminId BigInt?  @map("uploaded_by_admin_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  uploadedByAdmin   Admin?   @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([uploadedByAdminId])
  @@map("media_uploads")
}
