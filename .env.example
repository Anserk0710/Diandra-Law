# ==================================================
# DATABASE
# ==================================================

DATABASE_URL="mysql://DATABASE_USER:DATABASE_PASSWORD@127.0.0.1:3306/DATABASE_NAME"


# ==================================================
# AUTH.JS
# ==================================================

# Minimal 32 karakter random.
AUTH_SECRET="GANTI_DENGAN_SECRET_RANDOM_MINIMAL_32_KARAKTER"

# Gunakan true saat berada di belakang reverse proxy/cPanel.
AUTH_TRUST_HOST="true"


# ==================================================
# WEBSITE
# ==================================================

NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ==================================================
# MEDIA UPLOAD
# ==================================================

# Lokal boleh menggunakan path relatif.
# Production wajib menggunakan absolute path.
MEDIA_UPLOAD_ROOT="./public/cms/uploads"

MEDIA_PUBLIC_BASE_URL="/cms/uploads"

# Nilai yang diizinkan: lebih dari 0 dan maksimal 25.
MEDIA_MAX_FILE_SIZE_MB="5"


# ==================================================
# INITIAL SEED
# ==================================================

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="GANTI_PASSWORD_MINIMAL_12_KARAKTER"


# ==================================================
# CREATE / RESET ADMIN
# ==================================================

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="GANTI_PASSWORD_MINIMAL_12_KARAKTER"
ADMIN_NAME="Administrator"


# ==================================================
# AUTOMATED QA
# ==================================================

# Kosongkan ketika automated test dijalankan secara lokal.
QA_BASE_URL=""

QA_ADMIN_EMAIL="admin@example.com"
QA_ADMIN_PASSWORD="GANTI_PASSWORD_ADMIN"