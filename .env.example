# ==================================================
# DATABASE (Vercel Postgres / Neon)
# ==================================================

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"


# ==================================================
# AUTH.JS
# ==================================================

# Minimal 32 karakter random. Generate dengan: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_SECRET_RANDOM_MINIMAL_32_KARAKTER"

# Gunakan true saat berada di belakang reverse proxy / Vercel.
AUTH_TRUST_HOST="true"


# ==================================================
# WEBSITE
# ==================================================

NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ==================================================
# CLOUDINARY (File Storage)
# ==================================================

# Dapatkan dari: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Nilai yang diizinkan: lebih dari 0 dan maksimal 25.
MEDIA_MAX_FILE_SIZE_MB="5"


# ==================================================
# INITIAL SEED
# ==================================================

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="GANTI_PASSWORD_MINIMAL_12_KARAKTER"


# ==================================================
# CREATE / RESET ADMIN
# ==================================================

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="GANTI_PASSWORD_MINIMAL_12_KARAKTER"
ADMIN_NAME="Administrator"


# ==================================================
# AUTOMATED QA
# ==================================================

# Kosongkan ketika automated test dijalankan secara lokal.
QA_BASE_URL=""

QA_ADMIN_EMAIL="admin@example.com"
QA_ADMIN_PASSWORD="GANTI_PASSWORD_ADMIN"